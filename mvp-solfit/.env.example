# ===== AI 服务层接入点 =====
# LLM Provider（导购助手 / 内容生成）。留空 => 内置 mock 回复，开箱可跑。
# 任何 OpenAI 兼容端点均可（OpenAI / GLM / DeepSeek / Qwen / 本地 vLLM）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 数据层接入点（Phase 2：PostgreSQL，见 migrations/）=====
# 留空 => 内存种子数据。配置后执行迁移: npm run db:migrate
# 示例: postgresql://user:pass@host:5432/solfit
DATABASE_URL=

# ===== 缓存（Redis）=====
# 留空 => 内存 LRU 缓存。接入示例: redis://host:6379
REDIS_URL=

# ===== 支付（Stripe）=====
# 留空 => demo 模式（直接成功，不真实扣费）。生产必须配置。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===== 后台门禁（Phase 22 总后台）=====
# 商家后台 /admin/merchant 员工登录令牌种子（仅兜底；正式员工令牌由总后台签发）
ADMIN_TOKEN=dev-admin-token
# 总后台 /admin/master 超管令牌 —— 仅老板持有，生产必改
MASTER_TOKEN=dev-master-token

# ===== 跨境业务参数 =====
NEXT_PUBLIC_SITE_URL=https://solfit.example
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
# 免运费门槛（美元）
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=120
