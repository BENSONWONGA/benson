# ===== AI 服务层接入点 =====
# LLM Provider（导购助手 / 内容生成）。留空 => 内置 mock 回复，开箱可跑。
# 任何 OpenAI 兼容端点均可（OpenAI / GLM / DeepSeek / Qwen / 本地 vLLM）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 数据层接入点（Phase 2 换 PostgreSQL，见 src/lib/db.js）=====
# 留空 => 内存种子数据。接入示例: postgresql://user:pass@host:5432/solfit
DATABASE_URL=

# ===== 跨境业务参数 =====
NEXT_PUBLIC_SITE_URL=https://solfit.example
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
# 免运费门槛（美元）
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=120
